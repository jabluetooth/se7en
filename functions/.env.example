# ── se7en Cloud Functions — secret names ──────────────────────────────────────
#
# This file documents the secret names the deployed functions expect. It is
# NOT read by `firebase deploy` — Firebase Functions v2 secrets are pulled
# from Google Secret Manager via `defineSecret()`, not from a local .env file.
# Set each real value with the Firebase CLI (you will be prompted to paste it,
# it is never stored in this repo):
#
#   firebase functions:secrets:set GROQ_API_KEY
#   firebase functions:secrets:set HUGGINGFACE_API_KEY
#   firebase functions:secrets:set NEON_DATABASE_URL
#
# Optional, local-emulator-only: create a gitignored `functions/.env.local`
# with these same three names (`NAME=value`) and the Firebase emulator will
# load them for local testing. Never commit that file.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# HuggingFace Inference API — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Neon Postgres connection string — https://console.neon.tech
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=
