{
  "expo": {
    "name": "Se7en",
    "slug": "se7en",
    "scheme": "se7en",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.se7en.gymtracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d0f"
      },
      "package": "com.se7en.gymtracker",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withWidgets",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Se7en to access your photos so you can set a background for your workout summary."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Se7en to save workout summary images to your photos.",
          "savePhotosPermission": "Allow Se7en to save workout summary images to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "5e11bb45-3cc0-49ae-ba58-7e5634bbbb69"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5e11bb45-3cc0-49ae-ba58-7e5634bbbb69"
    }
  }
}
