<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_medium.xml
  Se7en 2×2 medium AppWidget layout.
  Dark background #0C0A08, amber accent #FF8C00, sky blue rest #64D2FF.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#0C0A08"
    android:gravity="start">

    <!-- ── Header row: icon + day label ───────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <!-- App icon badge -->
        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:text="7"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#FF8C00"
            android:layout_marginEnd="6dp" />

        <!-- Plan / day label -->
        <TextView
            android:id="@+id/widget_next_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Se7en"
            android:textColor="#8A7A6A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Session timer -->
        <TextView
            android:id="@+id/widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFF8F0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- ── Exercise name ────────────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_exercise_name"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No session"
        android:textColor="#FFF8F0"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="start|center_vertical" />

    <!-- ── Set counter row ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_set_counter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#FF8C00"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FF8C00"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Rest timer label (hidden when not resting) ──────────── -->
    <TextView
        android:id="@+id/widget_rest_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#64D2FF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

</LinearLayout>
