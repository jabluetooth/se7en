<?xml version="1.0" encoding="utf-8"?>
<!--
  se7en_widget_large_info.xml
  AppWidget metadata for the Se7en large (4×2) widget.
  updatePeriodMillis = 1800000 (30 minutes).
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_large"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description_large" />
