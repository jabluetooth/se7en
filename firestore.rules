rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // All user data is isolated under users/{uid}.
    // Only the authenticated owner may read or write their own subtree.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny every path not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
