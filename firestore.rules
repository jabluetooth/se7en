rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only the authenticated owner may read or write their own data.
    // Covers both the top-level user document and every subcollection beneath it
    // (plans, sessions, activeSession, prs, settings).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size() < 1048576;
    }

    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size() < 1048576;
    }

    // Explicitly deny every path not matched above.
    // Firestore denies by default, but this makes the intent unambiguous.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
