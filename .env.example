# ── Firebase ──────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── AI Coach — Groq / HuggingFace / Neon ──────────────────────────────────────
# These used to be EXPO_PUBLIC_* vars here, but that shipped a paid Groq key,
# a HuggingFace token, and a full unscoped Neon Postgres connection string
# inside the client app binary — anyone who decompiled the app could extract
# all three. They now live server-side only, as Firebase Cloud Functions v2
# secrets. See functions/.env.example for the secret names and
# functions/README.md for how the app calls them. To configure a deploy, run
# (from the repo root):
#
#   firebase functions:secrets:set GROQ_API_KEY
#   firebase functions:secrets:set HUGGINGFACE_API_KEY
#   firebase functions:secrets:set NEON_DATABASE_URL
#
# See docs/setup/neon-schema.sql for the underlying database setup steps.
